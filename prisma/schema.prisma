generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String    @id @default(uuid())
  email      String    @unique
  fullName   String
  membership String    @default("basic")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  sessions   Session[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpChallenge {
  id         String    @id @default(uuid())
  email      String
  mode       String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, mode, createdAt])
}

model LandingWellnessLounge {
  id          String                      @id
  title       String
  subtitle    String?
  actionLabel String?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  items       LandingWellnessLoungeItem[]
}

model LandingWellnessLoungeItem {
  id          String                @id
  name        String
  description String?
  image       String?
  color       String
  imageUrl    String?
  videoUrl    String?
  sectionId   String
  section     LandingWellnessLounge @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sortOrder   Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([sectionId, sortOrder])
}

model LandingHolisticSolutions {
  id          String                         @id
  title       String
  subtitle    String?
  actionLabel String?
  createdAt   DateTime                       @default(now())
  updatedAt   DateTime                       @updatedAt
  items       LandingHolisticSolutionsItem[]
}

model LandingHolisticSolutionsItem {
  id          String                   @id
  name        String
  description String?
  image       String?
  color       String
  imageUrl    String?
  sectionId   String
  section     LandingHolisticSolutions @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sortOrder   Int                      @default(0)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([sectionId, sortOrder])
}

model LandingKnowledgeHub {
  id          String                    @id
  title       String
  subtitle    String?
  actionLabel String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  items       LandingKnowledgeHubItem[]
}

model LandingKnowledgeHubItem {
  id           String              @id
  name         String
  description  String?
  price        String?
  color        String
  icon         String?
  iconImage    String?
  iconUrl      String?
  priceAmount  Int?
  currency     String?
  durationDays Int?
  sectionId    String
  section      LandingKnowledgeHub @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([sectionId, sortOrder])
}

